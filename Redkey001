    [5] = "G2nF-6qW9-yL3X-5sM4"  -- Active Week 5
}

-- Unix start time (Sep 5, 2026)
local START_TIMESTAMP = 1788625200 
local SCRIPT_URL = "https://raw.githubusercontent.com/UCT-hub/main/refs/heads/main/redz-v2"
local WEEK_IN_SECONDS = 604800 

-- ================================================================= --
-- ROTATION & DELTA COMPATIBILITY
-- ================================================================= --
local function GetCurrentTime()
    return os.time and os.time() or math.floor(tick())
end

local function GetCurrentActiveKey()
    local currentTime = GetCurrentTime()
    local elapsedTime = currentTime - START_TIMESTAMP
    
    if elapsedTime < 0 then
        return KEYS[1]
    end

    local currentPeriod = math.floor(elapsedTime / WEEK_IN_SECONDS)
    local keyIndex = (currentPeriod % #KEYS) + 1
    
    return KEYS[keyIndex]
end

-- Debug print to console (Check Delta Console to see the active key)
print("[KEY SYSTEM DEBUG] Active Key Needed:", GetCurrentActiveKey())

local function LoadMainScript()
    print("[KEY SYSTEM] Executing main script...")
    local success, err = pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
    if not success then
        warn("[KEY SYSTEM ERROR] Failed to load script:", err)
    end
end

