-- ================================================================= --
-- BUTTON EVENT HANDLERS
-- ================================================================= --
PasteBtn.MouseButton1Click:Connect(function()
    local getClip = getclipboard or clip_get or (syn and syn.crypt and syn.crypt.derive_key)
    if getClip then
        KeyInput.Text = tostring(getClip())
        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        StatusLabel.Text = "Pasted from clipboard!"
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "Clipboard not supported."
    end
end)

SubmitBtn.MouseButton1Click:Connect(function()
    local activeKey = GetCurrentActiveKey()
    local cleanInput = string.gsub(KeyInput.Text, "%s+", "") -- Strip spaces/newlines
    
    if cleanInput == activeKey then
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
        StatusLabel.Text = "Correct! Loading script..."
        task.wait(0.5)
        ScreenGui:Destroy()
        LoadMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "Invalid key for this week!"
    end
end)
                      
