-- SUBMIT HANDLER
-- ================================================================= --
SubmitBtn.MouseButton1Click:Connect(function()
    local activeKey = GetCurrentActiveKey()
    
    if KeyInput.Text == activeKey then
        StatusLabel.TextColor3 = Color3.fromRGB(75, 255, 75)
        StatusLabel.Text = "Success! Loading script..."
        task.wait(1)
        ScreenGui:Destroy()
        LoadMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
        StatusLabel.Text = "Invalid or expired key."
    end
end)
