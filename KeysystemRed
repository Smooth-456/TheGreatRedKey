-- 5 Randomly Generated Keys (rotates every 7 days and loops back):
local KEYS = {
    [1] = "K9xP-2mR7-vL4N-8qW1", -- Active Week 1
    [2] = "J3bT-9zF5-cX1V-7kM2", -- Active Week 2
    [3] = "H8wQ-4pL1-sY6Z-3nD9", -- Active Week 3
    [4] = "C5vB-8mK2-tR9P-1xJ7", -- Active Week 4
    [5] = "G2nF-6qW9-yL3X-5sM4"  -- Active Week 5
}

-- Start timestamp for the 5-week cycle (September 5, 2026)
local START_TIMESTAMP = 1788625200 

-- Target script to load upon successful key entry
local SCRIPT_URL = "https://raw.githubusercontent.com/UCT-hub/main/refs/heads/main/redz-v2"
local WEEK_IN_SECONDS = 7 * 86400 -- 7 days in seconds

-- ================================================================= --
-- KEY ROTATION & EXECUTION LOGIC
-- ================================================================= --
local function GetCurrentActiveKey()
    local currentTime = os.time()
    local elapsedTime = currentTime - START_TIMESTAMP
    
    if elapsedTime < 0 then
        return KEYS[1]
    end

    local currentPeriod = math.floor(elapsedTime / WEEK_IN_SECONDS)
    local keyIndex = (currentPeriod % #KEYS) + 1
    
    return KEYS[keyIndex]
end

local function LoadMainScript()
    print("Key accepted! Fetching and executing main script...")
    local success, err = pcall(function()
        loadstring(game:HttpGet(SCRIPT_URL))()
    end)
    if not success then
        warn("Failed to load target script:", err)
    end
end

